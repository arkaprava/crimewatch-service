MONGODB_URI=mongodb://localhost:27017/crime_info_service
REDIS_HOST=localhost
REDIS_PORT=6379
CRIME_READ_API_KEY=replace-with-read-key
CRIME_INGEST_API_KEY=replace-with-ingest-key
RATE_LIMIT_READ_PER_MINUTE=120
RATE_LIMIT_INGEST_PER_MINUTE=20
RATE_LIMIT_ANONYMOUS_PER_MINUTE=30
# Turns on the GraphiQL IDE (/graphiql) and schema introspection in the prod
# profile, both off by default. Queries still require an API key.
GRAPHIQL_ENABLED=false
